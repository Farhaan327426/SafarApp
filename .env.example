# SAFAR Application - Environment Variables Template
# Copy this file to .env and replace placeholders with production values.
# NEVER commit .env to version control.

# Server Configuration
PORT=3000
NODE_ENV=production

# Security & Session Secrets (Must be unique, cryptographically random strings)
JWT_SECRET=replace_with_strong_random_jwt_secret_min_32_chars
DRIVER_SHIFT_SECRET=replace_with_strong_driver_shift_secret
ADMIN_PIN=replace_with_strong_admin_pin

# CORS Whitelist (Comma-separated allowed origins)
CORS_ORIGIN=https://safarapp.in,https://admin.safarapp.in

# Database Configuration (SQLite / PostgreSQL)
DATABASE_URL=sqlite:./command-control-server/data/safar.db

# Redis Pub/Sub & Cache Configuration (Optional - falls back to in-memory)
REDIS_URL=redis://default:secure_redis_password@127.0.0.1:6379

# Payment Gateway Integrations
# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Monitoring & Error Reporting (Optional)
SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0
