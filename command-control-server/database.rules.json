{
  "rules": {
    "trips": {
      ".read": true,
      "$tripId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['lat', 'lng', 'updatedAt'])"
      }
    },
    "fares": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },
    "feedback": {
      ".read": "auth != null && auth.token.admin === true",
      "$feedbackId": {
        ".write": true,
        ".validate": "newData.hasChildren(['routeId', 'category', 'timestamp'])"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}