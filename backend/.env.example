# ================================================================================
# SAFAR — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ================================================================================
# SECURITY WARNING:
# Do NOT store real production secrets or private keys in this file.
# Copy this template to `.env` in your production deployment environment and replace
# all placeholder values with high-entropy production secrets.
# ================================================================================

# ─── 1. SERVER & SYSTEM ────────────────────────────────────────────────────────
# Network port the Node.js / Express backend listens on
PORT=3000

# Application environment: 'development', 'staging', or 'production'
NODE_ENV=development

# Allowed origins for Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN=http://localhost:8080

# ─── 2. DATABASE & REDIS ───────────────────────────────────────────────────────
# PostgreSQL connection string with PostGIS support
DATABASE_URL=postgresql://safar_user:safar_password@localhost:5432/safar_db?schema=public

# Redis connection URL for session storage, live GPS caching, and rate limiting
REDIS_URL=redis://localhost:6379

# ─── 3. AUTHENTICATION & SECURITY ─────────────────────────────────────────────
# Session encryption secret for express-session / cookie parser
SESSION_SECRET=dev_super_secret_safar_session_key_2026_change_in_production

# JWT Access Token signing secret (Must be a strong 256-bit random string in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_256bit

# JWT Refresh Token signing secret (Must be a strong 256-bit random string in production)
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_256bit

# JWT Access Token expiration duration (e.g., 15m, 1h)
JWT_ACCESS_EXPIRY=15m

# JWT Refresh Token expiration duration (e.g., 7d, 30d)
JWT_REFRESH_EXPIRY=7d

# ─── 4. CSRF PROTECTION ───────────────────────────────────────────────────────
# Anti-CSRF token verification secret key
CSRF_SECRET=dev_csrf_secret_key_xyz789_change_in_production

# ─── 5. RATE LIMITING ──────────────────────────────────────────────────────────
# Rate limit window duration in milliseconds (default: 60000ms = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per client IP per window
RATE_LIMIT_MAX_REQUESTS=100

# ─── 6. PUSH NOTIFICATIONS (WEB PUSH / VAPID) ─────────────────────────────────
# Public VAPID key for web push notification subscription registration
VAPID_PUBLIC_KEY=dev_vapid_public_key_demo_change_in_production

# Private VAPID key for signing web push payloads (Keep strictly secret!)
VAPID_PRIVATE_KEY=dev_vapid_private_key_demo_change_in_production

# VAPID contact identifier (mailto URL or web address)
VAPID_SUBJECT=mailto:admin@safar.jk.gov.in

# ─── 7. EMERGENCY INTEGRATION (PCR 112) ────────────────────────────────────────
# API access key for J&K Police Control Room 112 distress dispatch system
PCR_112_API_KEY=dev_pcr112_api_key_demo_change_in_production

# Production endpoint URL for automated SOS distress alerts
PCR_112_ENDPOINT=https://pcr112.jk.gov.in/api/v1/distress

# ─── 8. ADMIN SEED DEFAULTS ────────────────────────────────────────────────────
# Default super-admin phone number for database initialization
ADMIN_DEFAULT_PHONE=+919906000000

# Default super-admin password (MUST be changed immediately upon first login)
ADMIN_DEFAULT_PASSWORD=dev_admin_password_change_in_prod

# ─── 9. SERVICE WORKER & ASSET CACHING ────────────────────────────────────────
# Master cache version key embedded into PWA manifest & Service Worker
SW_CACHE_VERSION=v3.0.1

# ─── 10. LOGGING & DIAGNOSTICS ────────────────────────────────────────────────
# Application logging severity: 'debug', 'info', 'warn', or 'error'
LOG_LEVEL=info
