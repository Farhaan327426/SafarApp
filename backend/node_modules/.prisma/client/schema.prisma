generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COMMUTER
  DRIVER
  AUDITOR
  FARE_ADMIN
  ENFORCEMENT_OFFICER
  ADMIN
  SUPER_ADMIN
  VIEWER
}

enum Status {
  DRAFT
  REVIEW
  PUBLISHED
  SUPERSEDED
  ROLLED_BACK
}

enum PermitType {
  ALL_INDIA_TOURIST_PERMIT
  STATE_PERMIT
  CONTRACT_CARRIAGE_PERMIT
  STAGE_CARRIAGE_PERMIT
}

enum PermitVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
  SUSPENDED
}

enum HomeState {
  PB
  HP
  DL
  HR
  UT
  RJ
  UP
  CH
  MP
  MH
  GA
  OTHER
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String?   @map("tenant_id") @db.Uuid
  phoneNumber         String?   @unique @map("phone_number")
  username            String    @unique
  fullName            String?
  role                Role      @default(COMMUTER)
  passwordHash        String
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime? @map("lockout_until")
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions  Session[]
  auditLogs AuditLog[] @relation("ActorLogs")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String?  @map("refresh_token_hash")
  revoked          Boolean  @default(false)
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
}

model Route {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String?   @map("tenant_id") @db.Uuid
  routeNumber         String    @unique @map("route_code")
  origin              String    @map("origin_name")
  destination         String    @map("destination_name")
  distanceKm          Float     @map("total_distance_km")
  region              String
  terrain             String
  isActive            Boolean   @default(true) @map("is_active")
  completenessStatus  String    @default("INCOMPLETE") @map("completeness_status")
  verifiedAt          DateTime? @map("verified_at")
  verifiedBy          String?   @map("verified_by") @db.Uuid
  dataSource          String?   @map("data_source")
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  isJkmtNotified      Boolean   @default(false) @map("is_jkmt_notified")
  jkmtNotificationRef String?   @map("jkmt_notification_ref")
  routeCategory       String    @default("STAGE_CARRIAGE") @map("route_category")

  routeStops      RouteStop[]
  nonLocalPermits NonLocalPermit[]

  @@map("routes")
}

model TransitStop {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  externalStopId String?  @map("external_stop_id")
  stopName       String   @map("stop_name")
  latitude       Float
  longitude      Float
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  routeStops RouteStop[]

  @@map("transit_stops")
}

model RouteStop {
  id                   String   @id @default(uuid()) @db.Uuid
  routeId              String   @map("route_id") @db.Uuid
  stopId               String   @map("stop_id") @db.Uuid
  stopSequence         Int      @map("stop_sequence")
  cumulativeDistanceKm Float    @map("cumulative_distance_km")
  createdAt            DateTime @default(now()) @map("created_at")

  route       Route       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  transitStop TransitStop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([routeId, stopSequence])
  @@map("route_stops")
}

model FareVersion {
  id                 String    @id @default(uuid()) @db.Uuid
  version            Int       @unique
  status             Status    @default(DRAFT)
  reason             String?
  rates              Json // e.g. { "Kashmir": { "plain": 1.40, "hilly": 1.70 }, "Jammu": { "plain": 1.35, "hilly": 1.65 } }
  slabs              Json // e.g. { "3": 9, "5": 14, "10": 17, "15": 20, "20": 26 }
  vehicleMultipliers Json // e.g. { "minibus": 1.0, "tatamagic": 1.10, "sharedvan": 1.15 }
  publishedById      String?   @db.Uuid
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model FareSource {
  id                   String   @id @default(uuid()) @db.Uuid
  authority            String
  notificationNumber   String   @unique @map("notification_number")
  notificationDate     DateTime @map("notification_date") @db.Date
  effectiveDate        DateTime @map("effective_date") @db.Date
  title                String
  sourceUrl            String?  @map("source_url")
  documentHash         String?  @map("document_hash")
  referenceNotes       String?  @map("reference_notes")
  verificationStatus   String   @default("VERIFIED") @map("verification_status")
  isActiveSro          Boolean  @default(false) @map("is_active_sro")
  sroCode              String?  @map("sro_code")
  vehicleCategoryScope String?  @map("vehicle_category_scope")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  fareRules FareRule[]

  @@map("fare_sources")
}

model FareRule {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String?   @map("tenant_id") @db.Uuid
  sourceId           String?   @map("source_id") @db.Uuid
  vehicleType        String    @map("vehicle_type")
  vehicleCategory    String    @map("vehicle_category")
  fuelType           String?   @default("PETROL_DIESEL") @map("fuel_type")
  region             String    @default("all")
  terrain            String    @default("all")
  fareBasis          String    @map("fare_basis")
  distanceMinKm      Float     @default(0.0) @map("distance_min_km")
  distanceMaxKm      Float?    @map("distance_max_km")
  firstKmRate        Float?    @map("first_km_rate")
  subsequentKmRate   Float?    @map("subsequent_km_rate")
  perKmRate          Float?    @map("per_km_rate")
  flatFare           Float?    @map("flat_fare")
  routeId            String?   @map("route_id") @db.Uuid
  boardingStopId     String?   @map("boarding_stop_id") @db.Uuid
  deboardingStopId   String?   @map("deboarding_stop_id") @db.Uuid
  isSpecialEvent     Boolean   @default(false) @map("is_special_event")
  eventName          String?   @map("event_name")
  effectiveFrom      DateTime  @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  sourceAuthority    String    @map("source_authority")
  sourceNotification String    @map("source_notification")
  sourceDate         DateTime? @map("source_date") @db.Date
  sourceUrl          String?   @map("source_url")
  sourceReference    String?   @map("source_reference")
  verificationStatus String    @default("REVIEW_REQUIRED") @map("verification_status")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  fareSource FareSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@map("fare_rules")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @db.Uuid
  actor        User     @relation("ActorLogs", fields: [actorId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  requestId    String?
  createdAt    DateTime @default(now())
}

model ImportTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  status        String   @default("PENDING") // "PENDING", "COMMITTED", "ROLLED_BACK"
  rowsProcessed Int      @default(0)
  totalRows     Int
  errors        Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("import_transactions")
}

model PaymentTransaction {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String?
  boardingStopId       String?
  deboardingStopId     String?
  distanceKm           Float
  calculatedFareRupees Float
  actualPaidRupees     Float
  vehicleType          String
  concessionPct        Int      @default(0)
  paymentMethod        String // "DIGITAL" | "CASH" | "PASS"
  receiptCode          String   @unique
  gpsLatitude          Float?
  gpsLongitude         Float?
  timestamp            DateTime @default(now())

  @@map("payment_transactions")
}

model OverchargeAudit {
  id              String    @id @default(uuid()) @db.Uuid
  transactionId   String
  reportedBy      String?
  reportedAmount  Float
  regulatedAmount Float
  variance        Float
  reportedAt      DateTime  @default(now())
  status          String    @default("PENDING") // "PENDING" | "VERIFIED" | "DISMISSED"
  investigatedAt  DateTime?
  investigatedBy  String?

  @@map("overcharge_audits")
}

model NonLocalPermit {
  id                           String                   @id @default(uuid()) @db.Uuid
  permitNumber                 String                   @unique @map("permit_number")
  vehicleRegistration          String                   @map("vehicle_registration")
  operatorName                 String                   @map("operator_name")
  homeState                    HomeState                @map("home_state")
  homeStateRegExpiry           DateTime                 @map("home_state_reg_expiry") @db.Date
  vehicleCategory              PermitType               @map("vehicle_category")
  permittedRouteId             String?                  @map("permitted_route_id") @db.Uuid
  permittedCorridorDescription String                   @map("permitted_corridor_description")
  entryBorderPost              String                   @map("entry_border_post")
  inspectionCheckpoint         String                   @map("inspection_checkpoint")
  validFrom                    DateTime                 @map("valid_from")
  validUntil                   DateTime                 @map("valid_until")
  challanNumber                String                   @map("challan_number")
  taxFeeAmount                 Float                    @map("tax_fee_amount")
  taxFeePaidDate               DateTime                 @map("tax_fee_paid_date") @db.Date
  verificationStatus           PermitVerificationStatus @default(PENDING) @map("verification_status")
  issuedByAuthority            String                   @map("issued_by_authority")
  createdAt                    DateTime                 @default(now()) @map("created_at")
  updatedAt                    DateTime                 @updatedAt @map("updated_at")

  permittedRoute Route? @relation(fields: [permittedRouteId], references: [id], onDelete: SetNull)

  @@index([vehicleRegistration])
  @@index([verificationStatus])
  @@index([validUntil])
  @@index([entryBorderPost])
  @@map("non_local_permits")
}
